SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-or-publishable-key
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=configure-this-only-in-supabase-google-provider
RESEND_API_KEY=
RESEND_FROM_EMAIL=
APIFY_API_KEY=
# Server-only: never add these to public-config.js or browser code.
# Generate independent 32-byte base64url values. Preserve COMMERCE_CODE_KEY while
# any active code-protected orders exist; see docs/online-orders.md.
COMMERCE_CODE_KEY=
COMMERCE_MAINTENANCE_KEY=
# Optional comma-separated exact preview origins for commerce CORS.
COMMERCE_ALLOWED_ORIGINS=
# Optional legacy manual API routes; scheduled jobs now run in Supabase.
CRON_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
# Optional local administration token; never required by a browser/runtime user.
SUPABASE_ACCESS_TOKEN=
