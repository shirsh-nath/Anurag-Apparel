{
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/admin.html"
    },
    {
      "source": "/analytics",
      "destination": "/analytics.html"
    },
    {
      "source": "/analytics/:path*",
      "destination": "/analytics.html"
    },
    {
      "source": "/email",
      "destination": "/email_resend.html"
    },
    {
      "source": "/email/:path*",
      "destination": "/email_resend.html"
    }
  ],
  "crons": [
    {
      "path": "/api/purge-analytics",
      "schedule": "30 20 * * *"
    },
    {
      "path": "/api/sync-google-reviews",
      "schedule": "45 21 * * *"
    }
  ]
}
